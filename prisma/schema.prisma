generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole { OWNER ADMIN MEMBER VIEWER }
enum ContentType { POST VIDEO SCRIPT CAPTION HOOK IDEA IMAGE UGC }
enum ContentStatus { DRAFT SCHEDULED PUBLISHED ARCHIVED }
enum OpportunityStatus { NEW SAVED DISMISSED ACTIONED }
enum Platform { INSTAGRAM TIKTOK YOUTUBE X LINKEDIN OTHER }
enum ConnectionStatus { ACTIVE EXPIRED REVOKED ERROR }
enum Plan { FREE PRO BUSINESS AGENCY }
enum SubscriptionStatus { TRIALING ACTIVE PAST_DUE CANCELED EXPIRED }
enum BillingProvider { PADDLE STRIPE MANUAL }
enum GenerationStatus { QUEUED PROCESSING COMPLETED FAILED }
enum BackgroundJobStatus { QUEUED PROCESSING COMPLETED FAILED }
enum WebhookStatus { RECEIVED PROCESSED FAILED }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  memberships Membership[]
  contentItems ContentItem[] @relation("CreatedContent")
  analytics AnalyticsSnapshot[] @relation("UserAnalytics")
  auditLogs AuditLog[]
  generations GenerationJob[]
  idempotencyKeys IdempotencyKey[]
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id String @id @default(cuid())
  name String
  slug String @unique
  plan Plan @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  brandBrain BrandBrain?
  contentDNA ContentDNA?
  contentItems ContentItem[]
  opportunities Opportunity[]
  campaigns Campaign[]
  connections SocialConnection[]
  analytics AnalyticsSnapshot[]
  recommendations Recommendation[]
  subscription Subscription?
  usageCounters UsageCounter[]
  generations GenerationJob[]
  characters UGCCharacter[]
  backgroundJobs BackgroundJob[]
  idempotencyKeys IdempotencyKey[]
  webhookEvents WebhookEvent[]
  auditLogs AuditLog[]
}

model UGCCharacter {
  id String @id @default(cuid())
  workspaceId String
  name String
  description String?
  visualPrompt String?
  imageUrl String?
  metadata Json?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generations GenerationJob[]
  @@index([workspaceId, active])
}

model GenerationJob {
  id String @id @default(cuid())
  workspaceId String
  createdById String
  characterId String?
  contentId String?
  kind String
  status GenerationStatus @default(QUEUED)
  provider String
  model String
  prompt String
  operationName String?
  outputUrl String?
  outputMimeType String?
  error String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)
  character UGCCharacter? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  content ContentItem? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  @@index([workspaceId, status, createdAt])
  @@index([createdById, createdAt])
}

model BackgroundJob {
  id String @id @default(cuid())
  workspaceId String?
  kind String
  payload Json
  status BackgroundJobStatus @default(QUEUED)
  attempts Int @default(0)
  runAt DateTime @default(now())
  lockedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([status, runAt])
  @@index([workspaceId, status])
}

model IdempotencyKey {
  id String @id @default(cuid())
  workspaceId String
  userId String
  key String
  requestHash String
  status Int @default(202)
  response Json?
  createdAt DateTime @default(now())
  expiresAt DateTime
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, key])
  @@index([expiresAt])
}

model WebhookEvent {
  id String @id @default(cuid())
  provider BillingProvider
  providerEventId String @unique
  eventType String
  workspaceId String?
  status WebhookStatus @default(RECEIVED)
  payload Json
  error String?
  receivedAt DateTime @default(now())
  processedAt DateTime?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  @@index([provider, eventType, receivedAt])
  @@index([workspaceId, receivedAt])
}

model Subscription {
  id String @id @default(cuid())
  workspaceId String @unique
  plan Plan @default(FREE)
  status SubscriptionStatus @default(TRIALING)
  provider BillingProvider @default(MANUAL)
  customerId String?
  providerSubscriptionId String? @unique
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([provider, customerId])
  @@index([status, currentPeriodEnd])
}

model UsageCounter {
  id String @id @default(cuid())
  workspaceId String
  metric String
  periodStart DateTime
  count Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, metric, periodStart])
  @@index([workspaceId, periodStart])
}

model RateLimitBucket {
  id String @id @default(cuid())
  key String
  windowStart DateTime
  count Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([key, windowStart])
  @@index([windowStart])
}

model AuditLog {
  id String @id @default(cuid())
  workspaceId String?
  userId String?
  action String
  resource String?
  resourceId String?
  metadata Json?
  createdAt DateTime @default(now())
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Membership {
  id String @id @default(cuid())
  userId String
  workspaceId String
  role MembershipRole @default(MEMBER)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model BrandBrain {
  id String @id @default(cuid())
  workspaceId String @unique
  businessName String?
  niche String?
  audience String?
  positioning String?
  voice String?
  goals String[] @default([])
  offers String[] @default([])
  competitors String[] @default([])
  contentPillars String[] @default([])
  websiteUrl String?
  context Json?
  completeness Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ContentDNA {
  id String @id @default(cuid())
  workspaceId String @unique
  winningFormats Json?
  winningTopics Json?
  winningHooks Json?
  winningStructures Json?
  audienceSignals Json?
  platformPatterns Json?
  learnings String[] @default([])
  confidence Float @default(0)
  analyzedItems Int @default(0)
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ContentItem {
  id String @id @default(cuid())
  workspaceId String
  createdById String
  title String
  type ContentType
  status ContentStatus @default(DRAFT)
  platform Platform?
  body String?
  hook String?
  caption String?
  mediaUrl String?
  metadata Json?
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User @relation("CreatedContent", fields: [createdById], references: [id], onDelete: Cascade)
  analytics AnalyticsSnapshot[]
  generations GenerationJob[]
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
}

model Opportunity {
  id String @id @default(cuid())
  workspaceId String
  title String
  description String?
  source String?
  platform Platform?
  score Float @default(0)
  status OpportunityStatus @default(NEW)
  trendData Json?
  suggestedHook String?
  suggestedAngle String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status])
}

model Campaign {
  id String @id @default(cuid())
  workspaceId String
  name String
  description String?
  goal String?
  status String @default("DRAFT")
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model SocialConnection {
  id String @id @default(cuid())
  workspaceId String
  platform Platform
  accountId String
  username String?
  accessToken String?
  refreshToken String?
  expiresAt DateTime?
  scopes String[] @default([])
  status ConnectionStatus @default(ACTIVE)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, platform, accountId])
  @@index([workspaceId, platform])
}

model AnalyticsSnapshot {
  id String @id @default(cuid())
  workspaceId String
  contentId String?
  userId String?
  platform Platform
  date DateTime
  views Int @default(0)
  likes Int @default(0)
  comments Int @default(0)
  shares Int @default(0)
  saves Int @default(0)
  followers Int @default(0)
  reach Int @default(0)
  engagementRate Float @default(0)
  metadata Json?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content ContentItem? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user User? @relation("UserAnalytics", fields: [userId], references: [id], onDelete: Cascade)
  @@index([workspaceId, platform, date])
  @@index([workspaceId, date])
  @@index([contentId, date])
}

model Recommendation {
  id String @id @default(cuid())
  workspaceId String
  title String
  description String
  actionType String
  priority Int @default(0)
  confidence Float @default(0)
  status String @default("OPEN")
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status, priority])
}
